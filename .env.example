# App
APP_NAME=Sentinel
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://sentinel:sentinelpass@localhost:5432/sentinel

# Redis
REDIS_URL=redis://:sentinelredispass@localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth2 — Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth General
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=20

# Gateway
GATEWAY_CONFIG_PATH=./gateway.yml

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
